{
    "name": "@crosmos/codex",
    "version": "1.0.0",
    "description": "Persistent project memory for OpenAI Codex.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/crosmos-labs/codex-crosmos.git"
    },
    "homepage": "https://github.com/crosmos-labs/codex-crosmos",
    "bugs": {
        "url": "https://github.com/crosmos-labs/codex-crosmos/issues"
    },
    "keywords": [
        "codex",
        "openai",
        "crosmos",
        "memory",
        "cli"
    ],
    "license": "MIT",
    "type": "commonjs",
    "bin": {
        "crosmos-codex": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "format": "biome format --write .",
        "prepack": "npm run build"
    },
    "dependencies": {
        "crosmos": "0.3.2",
        "prompts": "^2.4.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@types/node": "^20.17.6",
        "@types/prompts": "^2.4.9",
        "typescript": "^5.8.3"
    },
    "files": [
        "dist",
        "docs",
        "skills"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    }
}
