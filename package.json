{
    "name": "@crosmos/codex",
    "version": "1.0.0",
    "description": "Persistent project memory for OpenAI Codex.",
    "type": "commonjs",
    "bin": {
        "crosmos-codex": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "format": "biome format --write .",
        "prepack": "npm run build"
    },
    "dependencies": {
        "crosmos": "github:crosmos-labs/crosmos-ts-sdk#v0.3.2",
        "prompts": "^2.4.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@types/node": "^20.17.6",
        "@types/prompts": "^2.4.9",
        "typescript": "^5.8.3"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    }
}
